---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getArticles, getArticleContent, getArticlesBySeries } from '../../lib/cms.js';
import { site } from '../../content/site.js';
import { formatDate, estimateReadingTime } from '../../lib/utils.js';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map(article => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { slug } = Astro.params;

// Fetch full content from Notion
const notionBlocks = await getArticleContent(article.id);
const readingTime = estimateReadingTime(article.excerpt);

// Build canonical URL
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://priteshkumar.com');

// Get related articles (same category, excluding current)
const allArticles = await getArticles();
const relatedArticles = allArticles
  .filter(a => a.category === article.category && a.slug !== slug)
  .slice(0, 2);

// Get series articles for navigation
const seriesArticles = article.series ? await getArticlesBySeries(article.series) : [];
const currentIndex = seriesArticles.findIndex(a => a.slug === slug);
const prevArticle = currentIndex > 0 ? seriesArticles[currentIndex - 1] : null;
const nextArticle = currentIndex < seriesArticles.length - 1 ? seriesArticles[currentIndex + 1] : null;

function escapeHtml(str) {
  if (!str) return '';
  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

const NOTION_COLOR_MAP = {
  // Text colors
  gray: 'text-gray-500 dark:text-gray-400',
  brown: 'text-amber-700 dark:text-amber-500',
  orange: 'text-orange-500 dark:text-orange-400',
  yellow: 'text-yellow-600 dark:text-yellow-400',
  green: 'text-emerald-600 dark:text-emerald-400',
  blue: 'text-sky-500 dark:text-sky-400 font-semibold',
  purple: 'text-purple-500 dark:text-purple-400',
  pink: 'text-pink-500 dark:text-pink-400',
  red: 'text-red-500 dark:text-red-400',

  // Background highlights
  gray_background: 'bg-gray-200 dark:bg-gray-800 px-1.5 py-0.5 rounded',
  brown_background: 'bg-amber-100 dark:bg-amber-900/40 px-1.5 py-0.5 rounded',
  orange_background: 'bg-orange-100 dark:bg-orange-900/40 px-1.5 py-0.5 rounded',
  yellow_background: 'bg-yellow-100 dark:bg-yellow-900/40 px-1.5 py-0.5 rounded',
  green_background: 'bg-emerald-100 dark:bg-emerald-900/40 px-1.5 py-0.5 rounded',
  blue_background: 'bg-sky-100 dark:bg-sky-900/40 px-1.5 py-0.5 rounded',
  purple_background: 'bg-purple-100 dark:bg-purple-900/40 px-1.5 py-0.5 rounded',
  pink_background: 'bg-pink-100 dark:bg-pink-900/40 px-1.5 py-0.5 rounded',
  red_background: 'bg-red-100 dark:bg-red-900/40 px-1.5 py-0.5 rounded',
};

function renderRichText(richTextArray) {
  if (!richTextArray || !Array.isArray(richTextArray)) return '';
  return richTextArray
    .map(rt => {
      let content = escapeHtml(rt.plain_text || '');
      const annotations = rt.annotations || {};

      if (annotations.bold) {
        content = `<strong class="font-bold text-primary-900 dark:text-primary-100">${content}</strong>`;
      }
      if (annotations.italic) {
        content = `<em class="italic">${content}</em>`;
      }
      if (annotations.strikethrough) {
        content = `<span class="line-through">${content}</span>`;
      }
      if (annotations.underline) {
        content = `<span class="underline underline-offset-4">${content}</span>`;
      }
      if (annotations.code) {
        content = `<code class="font-mono text-accent-400 bg-accent-500/10 px-1.5 py-0.5 rounded text-sm">${content}</code>`;
      }
      if (annotations.color && annotations.color !== 'default') {
        const colorClass = NOTION_COLOR_MAP[annotations.color] || '';
        if (colorClass) {
          content = `<span class="${colorClass}">${content}</span>`;
        }
      }

      const href = rt.href || rt.text?.link?.url;
      if (href) {
        content = `<a href="${escapeHtml(href)}" class="text-sky-500 hover:text-sky-400 underline font-medium transition-colors" target="_blank" rel="noopener noreferrer">${content}</a>`;
      }

      return content;
    })
    .join('');
}

// Render Notion blocks to HTML
function renderBlock(block) {
  switch (block.type) {
    case 'paragraph':
      return `<p class="text-primary-700 dark:text-primary-300 leading-relaxed mb-6">${renderRichText(block.paragraph?.rich_text)}</p>`;
    case 'heading_1':
      return `<h2 class="text-2xl sm:text-3xl font-bold text-primary-900 dark:text-primary-100 mt-10 mb-4 tracking-tight">${renderRichText(block.heading_1?.rich_text)}</h2>`;
    case 'heading_2':
      return `<h3 class="text-xl sm:text-2xl font-bold text-primary-900 dark:text-primary-100 mt-8 mb-3 tracking-tight">${renderRichText(block.heading_2?.rich_text)}</h3>`;
    case 'heading_3':
      return `<h4 class="text-lg sm:text-xl font-semibold text-primary-900 dark:text-primary-100 mt-6 mb-2 tracking-tight">${renderRichText(block.heading_3?.rich_text)}</h4>`;
    case 'bulleted_list_item':
      return `<li class="text-primary-700 dark:text-primary-300 leading-relaxed">${renderRichText(block.bulleted_list_item?.rich_text)}</li>`;
    case 'numbered_list_item':
      return `<li class="text-primary-700 dark:text-primary-300 leading-relaxed">${renderRichText(block.numbered_list_item?.rich_text)}</li>`;
    case 'code':
      return `<div class="p-6 bg-primary-950 border border-primary-800 text-accent-400 rounded-xl font-mono text-sm my-8 overflow-x-auto shadow-inner"><code>${escapeHtml(block.code?.rich_text?.map(t => t.plain_text).join('') || '')}</code></div>`;
    case 'quote':
      return `<blockquote class="border-l-4 border-accent-500 pl-6 py-3 my-6 text-primary-700 dark:text-primary-200 italic font-mono text-sm bg-accent-500/5 rounded-r-xl">${renderRichText(block.quote?.rich_text)}</blockquote>`;
    case 'callout': {
      const emoji = block.callout?.icon?.emoji ? `<span class="mr-2">${block.callout.icon.emoji}</span>` : '';
      return `<div class="p-5 bg-sky-500/10 border border-sky-500/20 rounded-xl my-6 text-primary-800 dark:text-primary-200 flex items-start">${emoji}<div>${renderRichText(block.callout?.rich_text)}</div></div>`;
    }
    case 'image': {
      const imgUrl =
        block.image?.type === 'external'
          ? block.image?.external?.url
          : block.image?.type === 'file'
            ? block.image?.file?.url
            : block.image?.file?.url || block.image?.external?.url;

      if (!imgUrl) return '';

      const captionText = renderRichText(block.image?.caption);
      const captionHtml = captionText
        ? `<figcaption class="mt-2.5 text-center text-xs font-mono text-primary-500 dark:text-primary-400">${captionText}</figcaption>`
        : '';

      return `
        <figure class="my-8">
          <img
            src="${escapeHtml(imgUrl)}"
            alt="${escapeHtml(block.image?.caption?.map(t => t.plain_text).join('') || '')}"
            class="w-full max-h-[600px] h-auto object-contain rounded-xl border border-primary-200/60 dark:border-primary-800/60 shadow-lg"
            loading="lazy"
          />
          ${captionHtml}
        </figure>
      `;
    }
    default:
      return '';
  }
}

let html = '';
let inList = false;
let listType = null;

notionBlocks.forEach(block => {
  if (block.type === 'bulleted_list_item') {
    if (!inList || listType !== 'ul') {
      if (inList) html += listType === 'ul' ? '</ul>' : '</ol>';
      html += '<ul class="list-disc list-inside text-primary-700 dark:text-primary-300 leading-relaxed mb-6 space-y-2">';
      inList = true;
      listType = 'ul';
    }
    html += renderBlock(block);
  } else if (block.type === 'numbered_list_item') {
    if (!inList || listType !== 'ol') {
      if (inList) html += listType === 'ul' ? '</ul>' : '</ol>';
      html += '<ol class="list-decimal list-inside text-primary-700 dark:text-primary-300 leading-relaxed mb-6 space-y-2">';
      inList = true;
      listType = 'ol';
    }
    html += renderBlock(block);
  } else {
    if (inList) {
      html += listType === 'ul' ? '</ul>' : '</ol>';
      inList = false;
      listType = null;
    }
    html += renderBlock(block);
  }
});

if (inList) {
  html += listType === 'ul' ? '</ul>' : '</ol>';
}
---

<Layout
  title={article.seoTitle || article.title}
  description={article.seoDescription || article.excerpt}
  image={article.featuredImage || '/og-default.jpg'}
  type="article"
  publishDate={article.publishDate}
>
  <Nav />
  <main class="max-w-3xl mx-auto px-6 py-16 pt-28 flex-1">
    <a href="/blog" class="inline-flex items-center gap-2 font-mono text-xs font-semibold text-accent-400 bg-accent-500/10 border border-accent-500/20 px-3.5 py-1.5 rounded-lg hover:border-accent-400/50 hover:bg-accent-500/20 transition-all mb-8">
      <span>←</span> Back to All Articles
    </a>

    <article>
      <!-- Header -->
      <div class="mb-10">
        {article.series && (
          <div class="flex items-center gap-3 mb-4">
            <span class="font-mono text-xs font-semibold text-accent-400 bg-accent-500/10 border border-accent-500/20 px-2.5 py-0.5 rounded-full uppercase tracking-wider">
              {article.series} Series
            </span>
            {article.seriesOrder && (
              <span class="font-mono text-xs text-primary-500 dark:text-primary-400">Part {article.seriesOrder}</span>
            )}
          </div>
        )}
        
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-primary-900 dark:text-primary-100 leading-[1.25] mb-6">
          {article.title}
        </h1>
        
        <p class="text-lg md:text-xl text-primary-600 dark:text-primary-300 leading-relaxed mb-6 font-light">{article.excerpt}</p>
        
        <div class="flex flex-wrap items-center gap-4 text-xs font-mono text-primary-500 dark:text-primary-400 pt-4 border-t border-primary-200/60 dark:border-primary-800/60">
          <span class="text-primary-900 dark:text-primary-100 font-semibold">{site.author.name}</span>
          <span>·</span>
          <span>{formatDate(article.publishDate)}</span>
          <span>·</span>
          <span class="text-accent-400 font-bold">{readingTime} min read</span>
        </div>
      </div>

      <!-- Featured Image -->
      {article.featuredImage && (
        <div class="w-full rounded-2xl mb-12 overflow-hidden border border-primary-200/60 dark:border-primary-800/60 shadow-xl bg-primary-900/40">
          <img
            src={article.featuredImage}
            alt={article.title}
            class="w-full max-h-[650px] h-auto object-contain rounded-2xl mx-auto"
            loading="eager"
          />
        </div>
      )}

      <!-- Table of Contents disabled -->

      <!-- Content -->
      <div class="prose prose-neutral dark:prose-invert max-w-none leading-relaxed" set:html={html} />

      <!-- Series Navigation -->
      {seriesArticles.length > 1 && (
        <div class="mt-16 p-6 bg-primary-100/60 dark:bg-primary-900/40 border border-primary-200/60 dark:border-primary-800/60 backdrop-blur-md rounded-2xl">
          <p class="font-mono text-xs text-accent-400 uppercase tracking-wider mb-4">{article.series} Series</p>
          <div class="flex items-center justify-between">
            {prevArticle ? (
              <a href={`/blog/${prevArticle.slug}`} class="text-sm font-semibold text-primary-900 dark:text-primary-100 hover:text-accent-400 transition-colors">
                ← {prevArticle.title}
              </a>
            ) : (
              <span class="text-primary-400 dark:text-primary-600 text-sm">← Previous</span>
            )}

            <div class="flex gap-2">
              {seriesArticles.map((_, i) => (
                <span class={`w-2 h-2 rounded-full ${i === currentIndex ? 'bg-accent-400' : 'bg-primary-300 dark:bg-primary-700'}`} />
              ))}
            </div>

            {nextArticle ? (
              <a href={`/blog/${nextArticle.slug}`} class="text-sm font-semibold text-primary-900 dark:text-primary-100 hover:text-accent-400 transition-colors">
                {nextArticle.title} →
              </a>
            ) : (
              <span class="text-primary-400 dark:text-primary-600 text-sm">Next →</span>
            )}
          </div>
        </div>
      )}

      <!-- Share -->
      <div class="mt-10 flex items-center gap-4 py-4 border-y border-primary-200/60 dark:border-primary-800/60">
        <span class="font-mono text-xs text-primary-500 uppercase tracking-wider">Share Article:</span>
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalURL.toString())}`}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 text-primary-500 hover:text-accent-400 transition-colors"
          aria-label="Share on LinkedIn"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
      </div>

      <!-- Author Bio -->
      <div class="mt-12 p-6 bg-primary-100/60 dark:bg-primary-900/40 border border-primary-200/60 dark:border-primary-800/60 backdrop-blur-md rounded-2xl">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-accent-500 to-cyan-400 flex items-center justify-center text-white font-bold text-lg flex-shrink-0 shadow-lg shadow-accent-500/20">
            PK
          </div>
          <div>
            <p class="font-bold text-primary-900 dark:text-primary-100">{site.author.name}</p>
            <p class="text-sm text-primary-600 dark:text-primary-400 mt-1 leading-relaxed">
              IT Infrastructure, Security & Cloud professional with 14+ years of experience. Writing about practical technology, infrastructure architecture, and security at the intersection of enterprise systems.
            </p>
          </div>
        </div>
      </div>

      <!-- Related Articles -->
      {relatedArticles.length > 0 && (
        <div class="mt-16">
          <h3 class="font-mono text-xs font-bold text-accent-400 uppercase tracking-widest mb-6">Related Articles</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {relatedArticles.map(rel => (
              <a href={`/blog/${rel.slug}`} class="block p-5 bg-primary-100/50 dark:bg-primary-900/40 border border-primary-200/60 dark:border-primary-800/60 backdrop-blur-md rounded-xl hover:border-accent-400/50 transition-all group">
                <h4 class="font-bold text-primary-900 dark:text-primary-100 group-hover:text-accent-400 transition-colors leading-snug">{rel.title}</h4>
                <p class="font-mono text-xs text-primary-500 dark:text-primary-400 mt-2">{rel.category || 'Article'} · {formatDate(rel.publishDate)}</p>
              </a>
            ))}
          </div>
        </div>
      )}
    </article>
  </main>
  <Footer />
</Layout>