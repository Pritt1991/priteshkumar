---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site, expertise, career } from '../content/site.js';
import { getArticles } from '../lib/cms.js';
import { formatDate } from '../lib/utils.js';

import { Image } from 'astro:assets';
import priteshImg from '../pritesh.jpg';
import { Server, ShieldCheck, Cloud, Activity, ClipboardCheck, Sparkles, X, Info } from '@lucide/astro';

const icons = [Server, ShieldCheck, Cloud, Activity, ClipboardCheck];

const cardPalettes = [
  {
    border: 'border-t-sky-500',
    iconText: 'text-sky-500 dark:text-sky-400',
    iconBg: 'bg-sky-500/10 border-sky-500/20 group-hover:bg-sky-500/20',
    hoverBorder: 'hover:border-sky-400/80 hover:shadow-sky-500/10',
    watermark: 'text-sky-500/10 dark:text-sky-400/10 group-hover:text-sky-500/20',
  },
  {
    border: 'border-t-emerald-500',
    iconText: 'text-emerald-500 dark:text-emerald-400',
    iconBg: 'bg-emerald-500/10 border-emerald-500/20 group-hover:bg-emerald-500/20',
    hoverBorder: 'hover:border-emerald-400/80 hover:shadow-emerald-500/10',
    watermark: 'text-emerald-500/10 dark:text-emerald-400/10 group-hover:text-emerald-500/20',
  },
  {
    border: 'border-t-indigo-500',
    iconText: 'text-indigo-500 dark:text-indigo-400',
    iconBg: 'bg-indigo-500/10 border-indigo-500/20 group-hover:bg-indigo-500/20',
    hoverBorder: 'hover:border-indigo-400/80 hover:shadow-indigo-500/10',
    watermark: 'text-indigo-500/10 dark:text-indigo-400/10 group-hover:text-indigo-500/20',
  },
  {
    border: 'border-t-amber-500',
    iconText: 'text-amber-500 dark:text-amber-400',
    iconBg: 'bg-amber-500/10 border-amber-500/20 group-hover:bg-amber-500/20',
    hoverBorder: 'hover:border-amber-400/80 hover:shadow-amber-500/10',
    watermark: 'text-amber-500/10 dark:text-amber-400/10 group-hover:text-amber-500/20',
  },
  {
    border: 'border-t-purple-500',
    iconText: 'text-purple-500 dark:text-purple-400',
    iconBg: 'bg-purple-500/10 border-purple-500/20 group-hover:bg-purple-500/20',
    hoverBorder: 'hover:border-purple-400/80 hover:shadow-purple-500/10',
    watermark: 'text-purple-500/10 dark:text-purple-400/10 group-hover:text-purple-500/20',
  },
];

const articles = await getArticles();
const teaserArticles = articles.slice(0, 3);
const featuredArticle = teaserArticles[0] || null;
const latestArticles = teaserArticles.slice(1);

function cleanExcerpt(excerpt) {
  if (!excerpt) return '';
  if (excerpt.includes('TODO') || excerpt.includes('internal note') || excerpt.includes('placeholder')) {
    return "A practical step-by-step guide to replacing raw public IP access on FortiGate firewall management interfaces with a trusted FQDN and Let's Encrypt SSL certificate.";
  }
  return excerpt;
}
---

<Layout>
  <Nav />
  <main class="flex-1">
    <!-- Hero Section (Aver Theme Pattern) -->
    <!-- Background Options:
         Option A (Active): bg-gradient-to-b from-[#0f1729] to-[#1a2138] (Charcoal-Navy with depth)
         Option B (Alternate): bg-gradient-to-br from-[#101820] via-[#16232b] to-[#0d1620] (Slate-Teal undertone)
         Option C (Alternate): bg-gradient-to-b from-[#0a0f1d] via-[#0f172a] to-[#141c33] (Deep Royal Navy)
    -->
    <section class="pt-20 pb-20 relative overflow-hidden bg-gradient-to-b from-[#0f1729] to-[#1a2138] text-white -mt-20">
      <!-- Decorative Outlined Stroke Text Behind Content -->
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none overflow-hidden" aria-hidden="true">
        <span id="hero-watermark" class="hero-watermark font-['Big_Shoulders_Display'] text-[15vw] font-black uppercase tracking-widest hidden sm:block text-sky-500/10 opacity-25 whitespace-nowrap will-change-transform transition-transform duration-75 ease-out">
          INFRASTRUCTURE &amp; SECURITY
        </span>
      </div>

      <!-- Hero Content Container -->
      <div class="max-w-6xl mx-auto px-6 w-full pt-20 relative z-10 text-center animate-fade-in-up motion-reduce:animate-none">
        <!-- Tagline Pill Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-sky-500/10 border border-sky-500/20 text-sky-400 font-mono text-xs font-semibold uppercase tracking-wider mb-8">
          <span class="text-amber-500">⚡</span> {site.tagline}
        </div>

        <!-- Name + Photo Layout Heading (Font: Bodoni Moda; Alternates: font-['Playfair_Display'] / font-['DM_Serif_Display']) -->
        <h1 class="font-['Bodoni_Moda'] font-medium uppercase tracking-wider text-4xl sm:text-6xl md:text-7xl lg:text-8xl xl:text-[6.5rem] text-white flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 mb-6 leading-none">
          <span>PRITESH</span>
          <!-- Circular Photo (~110-130px) with Cyan Ring & Sparkle Accent -->
          <div class="relative inline-block my-2 sm:my-0 mx-1 sm:mx-3 group flex-shrink-0">
            <div class="w-20 h-20 sm:w-24 sm:h-24 md:w-28 md:h-28 lg:w-32 lg:h-32 rounded-full overflow-hidden border-2 border-sky-400/80 shadow-2xl shadow-sky-500/30 group-hover:scale-105 transition-transform duration-500">
              <Image src={priteshImg} alt="Pritesh Kumar" class="w-full h-full object-cover" width={320} height={320} loading="eager" />
            </div>
            <Sparkles class="w-5 h-5 sm:w-6 sm:h-6 text-sky-400 absolute -top-1 -right-1 animate-pulse motion-reduce:animate-none drop-shadow-md" />
          </div>
          <span>KUMAR</span>
        </h1>

        <!-- Tagline Copy -->
        <p class="max-w-[620px] mx-auto font-sans font-normal tracking-wide text-base sm:text-lg md:text-xl text-primary-300 leading-relaxed mb-10">
          I'm {site.name}, an IT Infrastructure, Network, Security and Cloud professional with 14+ years of experience working with enterprise technology environments.
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a href="/blog" class="px-7 py-3.5 bg-gradient-to-r from-sky-600 via-sky-500 to-cyan-500 hover:from-sky-500 hover:to-cyan-400 text-white font-semibold text-sm rounded-xl shadow-lg shadow-sky-500/25 hover:shadow-sky-500/40 hover:scale-[1.02] hover:-translate-y-0.5 transition-all duration-300 motion-reduce:hover:translate-y-0 motion-reduce:hover:scale-100">
            Read My Articles →
          </a>
          <a href="#about" class="px-7 py-3.5 border border-primary-700/80 hover:border-sky-400/60 bg-primary-900/60 backdrop-blur-sm text-primary-200 font-semibold text-sm rounded-xl hover:scale-[1.02] hover:-translate-y-0.5 transition-all duration-300 motion-reduce:hover:translate-y-0 motion-reduce:hover:scale-100">
            More About Me
          </a>
        </div>
      </div>
    </section>

    <!-- Introduction Section -->
    <section class="pt-12 pb-6 border-t border-primary-200/60 dark:border-primary-800/60 relative">
      <div class="max-w-6xl mx-auto px-6">
        <div class="max-w-[620px]">
          <p class="font-sans font-normal tracking-wide text-base sm:text-lg md:text-xl text-balance text-primary-800 dark:text-primary-200 leading-relaxed">
            My work sits at the intersection of <span class="font-semibold bg-gradient-to-r from-sky-400 via-cyan-400 to-sky-400 bg-clip-text text-transparent">infrastructure, networking, security, cloud, and IT operations</span>. I like solving practical problems and making complex infrastructure understandable.
          </p>
        </div>
      </div>
    </section>

    <!-- Expertise & Ventures Grid ("What I Work With") -->
    <section class="pt-6 pb-6 relative">
      <div class="max-w-6xl mx-auto px-6">
        <div class="flex items-center gap-3 mb-10">
          <div class="h-px w-8 bg-sky-500"></div>
          <h2 class="text-xs font-mono font-bold text-sky-500 dark:text-sky-400 tracking-widest uppercase">What I Work With</h2>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {expertise.map((item, idx) => {
            const IconComponent = icons[idx] || Server;
            const palette = cardPalettes[idx % cardPalettes.length];
            return (
              <div class={`relative overflow-hidden bg-primary-100/80 dark:bg-primary-900/60 border border-primary-200/60 dark:border-primary-800/60 border-t-4 ${palette.border} backdrop-blur-md rounded-2xl p-6 shadow-sm transition-all duration-300 hover:-translate-y-1.5 motion-reduce:hover:translate-y-0 ${palette.hoverBorder} hover:shadow-xl group flex flex-col justify-between`}>
                <!-- Watermark Number -->
                <span class={`absolute top-2 right-4 font-mono text-6xl font-black ${palette.watermark} select-none pointer-events-none transition-colors`}>
                  0{idx + 1}
                </span>
                <div class="relative z-10">
                  <div class={`p-3 rounded-xl ${palette.iconBg} w-max mb-4 transition-colors`}>
                    <IconComponent class={`w-5 h-5 ${palette.iconText}`} />
                  </div>
                  <h3 class="text-xl font-bold text-primary-900 dark:text-primary-100 mb-3 group-hover:text-sky-400 transition-colors">
                    {item.title}
                  </h3>
                  <p class="text-sm text-primary-600 dark:text-primary-400 leading-relaxed">
                    {item.description}
                  </p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- About + Career Timeline Section -->
    <section id="about" class="pt-6 pb-12 border-t border-primary-200/60 dark:border-primary-800/60 relative">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
          <!-- About -->
          <div>
            <div class="flex items-center gap-3 mb-6">
              <div class="h-px w-8 bg-sky-500"></div>
              <h2 class="text-xs font-mono font-bold text-sky-500 dark:text-sky-400 tracking-widest uppercase">About</h2>
            </div>
            <div class="space-y-5 font-sans font-normal text-sm sm:text-base text-primary-700 dark:text-primary-300 leading-relaxed">
              <p>I approach technology with a practical mindset - systems should work reliably, securely, and transparently. Over 14 years, I've learned that the best infrastructure is the kind nobody notices because it just works.</p>
              <p>I'm currently deepening my expertise in cloud security architecture and zero-trust networking. I believe in continuous learning and sharing what I discover along the way.</p>
            </div>
          </div>

          <!-- Career Timeline -->
          <div>
            <div class="flex items-center gap-3 mb-6">
              <div class="h-px w-8 bg-sky-500"></div>
              <h2 class="text-xs font-mono font-bold text-sky-500 dark:text-sky-400 tracking-widest uppercase">Career</h2>
            </div>
            
            <div class="bg-primary-100/80 dark:bg-primary-900/60 border border-primary-200/60 dark:border-primary-800/60 backdrop-blur-md rounded-2xl p-6 shadow-sm">
              <div class="border-l-2 border-sky-500/30 ml-2.5 pl-6 space-y-6 relative">
                {career.map((job, idx) => (
                  <div class="relative group">
                    <!-- Node Icon -->
                    <div class:list={[
                      'absolute -left-[31px] top-1.5 h-3.5 w-3.5 rounded-full transition-transform duration-300 group-hover:scale-125',
                      idx === 0
                        ? 'bg-sky-500 ring-4 ring-sky-500/20 shadow-sm shadow-sky-500 animate-pulse motion-reduce:animate-none'
                        : 'bg-primary-400 dark:bg-primary-700'
                    ]}></div>
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                      {idx === 0 ? (
                        <button
                          type="button"
                          id="seeds-fincap-trigger"
                          onclick="openSeedsModal(this)"
                          class="font-sans font-bold text-primary-900 dark:text-primary-100 text-sm sm:text-base group-hover:text-sky-400 hover:text-sky-400 hover:underline decoration-sky-400/50 transition-colors flex items-center gap-1.5 text-left focus:outline-none focus:ring-2 focus:ring-sky-400/50 rounded-md cursor-pointer"
                          aria-haspopup="dialog"
                          aria-controls="seeds-fincap-modal"
                        >
                          <span>{job.company}</span>
                          <Info class="w-4 h-4 text-sky-400 opacity-80 group-hover:opacity-100 flex-shrink-0" />
                        </button>
                      ) : idx === 1 ? (
                        <button
                          type="button"
                          id="mascallnet-trigger"
                          onclick="openMascallnetModal(this)"
                          class="font-sans font-bold text-primary-900 dark:text-primary-100 text-sm sm:text-base group-hover:text-sky-400 hover:text-sky-400 hover:underline decoration-sky-400/50 transition-colors flex items-center gap-1.5 text-left focus:outline-none focus:ring-2 focus:ring-sky-400/50 rounded-md cursor-pointer"
                          aria-haspopup="dialog"
                          aria-controls="mascallnet-modal"
                        >
                          <span>{job.company}</span>
                          <Info class="w-4 h-4 text-sky-400 opacity-80 group-hover:opacity-100 flex-shrink-0" />
                        </button>
                      ) : idx === 2 ? (
                        <button
                          type="button"
                          id="satya-trigger"
                          onclick="openSatyaModal(this)"
                          class="font-sans font-bold text-primary-900 dark:text-primary-100 text-sm sm:text-base group-hover:text-sky-400 hover:text-sky-400 hover:underline decoration-sky-400/50 transition-colors flex items-center gap-1.5 text-left focus:outline-none focus:ring-2 focus:ring-sky-400/50 rounded-md cursor-pointer"
                          aria-haspopup="dialog"
                          aria-controls="satya-modal"
                        >
                          <span>{job.company}</span>
                          <Info class="w-4 h-4 text-sky-400 opacity-80 group-hover:opacity-100 flex-shrink-0" />
                        </button>
                      ) : (
                        <button
                          type="button"
                          id="onicra-trigger"
                          onclick="openOnicraModal(this)"
                          class="font-sans font-bold text-primary-900 dark:text-primary-100 text-sm sm:text-base group-hover:text-sky-400 hover:text-sky-400 hover:underline decoration-sky-400/50 transition-colors flex items-center gap-1.5 text-left focus:outline-none focus:ring-2 focus:ring-sky-400/50 rounded-md cursor-pointer"
                          aria-haspopup="dialog"
                          aria-controls="onicra-modal"
                        >
                          <span>{job.company}</span>
                          <Info class="w-4 h-4 text-sky-400 opacity-80 group-hover:opacity-100 flex-shrink-0" />
                        </button>
                      )}
                      <span class="font-mono text-xs text-sky-600 dark:text-sky-400 bg-sky-500/10 border border-sky-500/20 px-2.5 py-0.5 rounded-full w-max">
                        {job.years}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Blog Teaser Section -->
    <section class="pt-6 pb-6 border-t border-primary-200/60 dark:border-primary-800/60 relative">
      <div class="max-w-6xl mx-auto px-6">
        <div class="flex items-center justify-between mb-8">
          <div class="flex items-center gap-3">
            <div class="h-px w-8 bg-sky-500"></div>
            <h2 class="text-xs font-mono font-bold text-sky-500 dark:text-sky-400 tracking-widest uppercase">From the Blog</h2>
          </div>
          <a href="/blog" class="text-sm font-semibold text-sky-500 hover:text-sky-400 transition-colors flex items-center gap-1 group">
            View all articles <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>

        {teaserArticles.length === 0 ? (
          <p class="text-primary-500 dark:text-primary-400">Articles coming soon.</p>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {featuredArticle && (
              <article class="bg-primary-100/50 dark:bg-primary-900/40 border border-primary-200/60 dark:border-primary-800/60 backdrop-blur-md rounded-2xl p-5 hover:border-sky-400/50 hover:shadow-xl transition-all duration-300 group cursor-pointer flex flex-col justify-between" onclick={`window.location.href='/blog/${featuredArticle.slug}'`}>
                <div>
                  <div class="aspect-[16/10] bg-primary-200 dark:bg-primary-800 rounded-xl mb-4 overflow-hidden relative">
                    {featuredArticle.featuredImage ? (
                      <img
                        src={featuredArticle.featuredImage}
                        alt={featuredArticle.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        loading="lazy"
                      />
                    ) : (
                      <div class="w-full h-full bg-gradient-to-br from-sky-500/20 via-primary-800 to-primary-900 group-hover:scale-105 transition-transform duration-500 flex items-center justify-center">
                        <span class="font-mono text-xs text-sky-400">Pritesh Kumar</span>
                      </div>
                    )}
                  </div>
                  <span class="font-mono text-xs font-semibold text-sky-500 dark:text-sky-400 uppercase tracking-wider bg-sky-500/10 border border-sky-500/20 px-2.5 py-0.5 rounded-md inline-block mb-2">Featured</span>
                  <h3 class="text-lg font-bold text-primary-900 dark:text-primary-100 group-hover:text-sky-400 transition-colors leading-snug">
                    {featuredArticle.title}
                  </h3>
                  <p class="text-sm text-primary-600 dark:text-primary-400 mt-2 line-clamp-2">{cleanExcerpt(featuredArticle.excerpt)}</p>
                </div>
              </article>
            )}
            {latestArticles.map(article => (
              <article class="bg-primary-100/50 dark:bg-primary-900/40 border border-primary-200/60 dark:border-primary-800/60 backdrop-blur-md rounded-2xl p-5 hover:border-sky-400/50 hover:shadow-xl transition-all duration-300 group cursor-pointer flex flex-col justify-between" onclick={`window.location.href='/blog/${article.slug}'`}>
                <div>
                  <div class="aspect-[16/10] bg-primary-200 dark:bg-primary-800 rounded-xl mb-4 overflow-hidden relative">
                    {article.featuredImage ? (
                      <img
                        src={article.featuredImage}
                        alt={article.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        loading="lazy"
                      />
                    ) : (
                      <div class="w-full h-full bg-gradient-to-br from-primary-800 to-primary-950 group-hover:scale-105 transition-transform duration-500 flex items-center justify-center">
                        <span class="font-mono text-xs text-primary-400">Blog Article</span>
                      </div>
                    )}
                  </div>
                  <span class="font-mono text-xs font-medium text-primary-500 dark:text-primary-400 uppercase tracking-wide inline-block mb-2">{article.category || 'Article'}</span>
                  <h3 class="text-lg font-bold text-primary-900 dark:text-primary-100 group-hover:text-sky-400 transition-colors leading-snug">
                    {article.title}
                  </h3>
                  <p class="text-sm text-primary-600 dark:text-primary-400 mt-2 line-clamp-2">{cleanExcerpt(article.excerpt)}</p>
                </div>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- Contact Section -->
    <section class="pt-6 pb-16 border-t border-primary-200/60 dark:border-primary-800/60 relative">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-8 text-primary-900 dark:text-primary-100">
          Let's Talk <span class="bg-gradient-to-r from-sky-400 via-cyan-400 to-sky-400 bg-clip-text text-transparent">Technology.</span>
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <a
            href={site.author.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="p-6 bg-primary-100/60 dark:bg-primary-900/40 border border-primary-200/60 dark:border-primary-800/60 backdrop-blur-md rounded-2xl hover:border-emerald-400/50 hover:shadow-xl transition-all group"
          >
            <div class="flex items-center gap-3 mb-3">
              <div class="p-2 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              </div>
              <span class="font-bold text-primary-900 dark:text-primary-100">WhatsApp</span>
            </div>
            <p class="text-primary-500 dark:text-primary-400 text-sm font-mono group-hover:text-emerald-400 transition-colors">{site.author.whatsappNumber}</p>
          </a>

          <a
            href={`mailto:${site.author.email}`}
            class="p-6 bg-primary-100/60 dark:bg-primary-900/40 border border-primary-200/60 dark:border-primary-800/60 backdrop-blur-md rounded-2xl hover:border-sky-400/50 hover:shadow-xl transition-all group"
          >
            <div class="flex items-center gap-3 mb-3">
              <div class="p-2 rounded-lg bg-sky-500/10 text-sky-400 border border-sky-500/20">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <span class="font-bold text-primary-900 dark:text-primary-100">Email</span>
            </div>
            <p class="text-primary-500 dark:text-primary-400 text-sm font-mono group-hover:text-sky-400 transition-colors">{site.author.email}</p>
          </a>

          <a
            href={site.author.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="p-6 bg-primary-100/60 dark:bg-primary-900/40 border border-primary-200/60 dark:border-primary-800/60 backdrop-blur-md rounded-2xl hover:border-sky-400/50 hover:shadow-xl transition-all group"
          >
            <div class="flex items-center gap-3 mb-3">
              <div class="p-2 rounded-lg bg-sky-500/10 text-sky-400 border border-sky-500/20">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
