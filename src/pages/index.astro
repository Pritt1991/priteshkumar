  function openOnicraModal(triggerEl) {
    lastActiveElement = triggerEl || document.activeElement;
    const modal = document.getElementById('onicra-modal');
    if (modal && typeof modal.showModal === 'function') {
      modal.showModal();
    }
  }

  function closeOnicraModal() {
    const modal = document.getElementById('onicra-modal');
    if (modal && typeof modal.close === 'function') {
      modal.close();
    }
    if (lastActiveElement && typeof lastActiveElement.focus === 'function') {
      lastActiveElement.focus();
    }
  }

  function bindCareerModalEvents() {
    ['seeds-fincap-modal', 'mascallnet-modal', 'satya-modal', 'onicra-modal'].forEach((id) => {
      const modal = document.getElementById(id);
      if (modal && !modal.dataset.bound) {
        modal.dataset.bound = 'true';
        // Backdrop click listener: native dialog backdrop click target is the dialog element itself
        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            modal.close();
          }
        });
        // Restore focus on native close (e.g. Esc key)
        modal.addEventListener('close', () => {
          if (lastActiveElement && typeof lastActiveElement.focus === 'function') {
            lastActiveElement.focus();
          }
        });
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindCareerModalEvents);
  } else {
    bindCareerModalEvents();
  }
  document.addEventListener('astro:page-load', bindCareerModalEvents);
</script>