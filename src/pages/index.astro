---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site, expertise, career } from '../content/site.js';
import { getArticles } from '../lib/cms.js';
import { formatDate } from '../lib/utils.js';

import { Image } from 'astro:assets';
import priteshImg from '../pritesh.jpg';
import { Server, ShieldCheck, Cloud, Activity, ClipboardCheck } from '@lucide/astro';

const icons = [Server, ShieldCheck, Cloud, Activity, ClipboardCheck];

const articles = await getArticles();
const teaserArticles = articles.slice(0, 3);
const featuredArticle = teaserArticles[0] || null;
const latestArticles = teaserArticles.slice(1);
---

<Layout>
  <Nav />
  <main class="flex-1">
    <!-- Hero Section -->
    <section class="pt-24 pb-10">
      <div class="max-w-6xl mx-auto px-6 w-full">
        <div class="flex flex-col md:flex-row items-center gap-12 md:gap-16">
          <!-- Photo Container with Gradient Ring & Hover Scale -->
          <div class="order-1 md:order-2 flex-shrink-0">
            <div class="p-1.5 rounded-3xl bg-gradient-to-tr from-sky-500 via-cyan-400 to-blue-600 shadow-2xl shadow-sky-500/20 hover:scale-[1.02] transition-transform duration-500">
              <div class="w-64 h-64 md:w-80 md:h-80 rounded-[1.25rem] overflow-hidden bg-primary-900">
                <Image src={priteshImg} alt="Pritesh Kumar" class="w-full h-full object-cover" width={640} height={640} loading="eager" />
              </div>
            </div>
          </div>

          <!-- Text Intro -->
          <div class="order-2 md:order-1 max-w-2xl">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-500/20 text-sky-600 dark:text-sky-400 font-mono text-xs font-semibold uppercase tracking-wider mb-6">
              <span class="text-amber-500">⚡</span> {site.tagline}
            </div>
            <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-primary-900 dark:text-primary-100 leading-[1.1] mb-8">
              I build, secure<br>and operate <span class="font-black text-[1.06em] bg-gradient-to-r from-sky-500 via-cyan-400 to-blue-500 bg-clip-text text-transparent">IT infrastructure.</span>
            </h1>
            <p class="text-lg md:text-xl text-primary-600 dark:text-primary-300 leading-relaxed mb-10">
              I'm {site.name}, an IT Infrastructure, Security and Cloud professional with 14+ years of experience working with enterprise technology environments.
            </p>
            <div class="flex flex-wrap items-center gap-4">
              <a href="/blog" class="px-7 py-3.5 bg-gradient-to-r from-sky-600 via-sky-500 to-cyan-500 hover:from-sky-500 hover:to-cyan-400 text-white font-semibold text-sm rounded-xl shadow-lg shadow-sky-500/20 hover:shadow-sky-500/40 hover:scale-[1.02] hover:-translate-y-0.5 transition-all duration-300">
                Read My Articles →
              </a>
              <a href="#about" class="px-7 py-3.5 border border-primary-300/80 dark:border-primary-700/80 hover:border-amber-400/60 bg-primary-100/50 dark:bg-primary-900/50 backdrop-blur-sm text-primary-900 dark:text-primary-100 font-semibold text-sm rounded-xl hover:scale-[1.02] hover:-translate-y-0.5 transition-all duration-300">
                More About Me
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Introduction Section -->
    <section class="py-10 border-t border-primary-200/60 dark:border-primary-800/60 relative">
      <div class="max-w-6xl mx-auto px-6">
        <div class="max-w-4xl">
          <p class="text-2xl md:text-3xl font-light text-primary-800 dark:text-primary-200 leading-relaxed">
            My work sits at the intersection of <span class="font-semibold bg-gradient-to-r from-sky-400 via-cyan-400 to-blue-400 bg-clip-text text-transparent">infrastructure, networking, security, cloud, and IT operations</span>. I like solving practical problems and making complex infrastructure understandable.
          </p>
        </div>
      </div>
    </section>

    <!-- Expertise & Ventures Grid ("What I Work With") -->
    <section class="py-12 relative">
      <div class="max-w-6xl mx-auto px-6">
        <div class="flex items-center gap-3 mb-8">
          <div class="h-px w-8 bg-sky-500"></div>
          <h2 class="text-xs font-mono font-bold text-sky-500 dark:text-sky-400 tracking-widest uppercase">What I Work With</h2>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {expertise.map((item, idx) => {
            const IconComponent = icons[idx] || Server;
            return (
              <div class="relative overflow-hidden bg-primary-100/80 dark:bg-primary-900/60 border border-primary-200/60 dark:border-primary-800/60 backdrop-blur-md rounded-2xl p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-sky-400/50 hover:shadow-xl hover:shadow-sky-500/5 group flex flex-col justify-between">
                <!-- Watermark Number -->
                <span class="absolute top-2 right-4 font-mono text-6xl font-black text-sky-500/10 dark:text-sky-400/10 select-none pointer-events-none group-hover:text-sky-500/20 transition-colors">
                  0{idx + 1}
                </span>
                <div class="relative z-10">
                  <div class="p-2.5 rounded-xl bg-sky-500/10 border border-sky-500/20 w-max mb-4 group-hover:bg-sky-500/20 transition-colors">
                    <IconComponent class="w-5 h-5 text-sky-600 dark:text-sky-400" />
                  </div>
                  <h3 class="text-xl font-bold text-primary-900 dark:text-primary-100 mb-3 group-hover:text-sky-400 transition-colors">
                    {item.title}
                  </h3>
                  <p class="text-sm text-primary-600 dark:text-primary-400 leading-relaxed">
                    {item.description}
                  </p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- About + Career Timeline Section -->
    <section id="about" class="py-12 border-t border-primary-200/60 dark:border-primary-800/60 relative">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
          <!-- About -->
          <div>
            <div class="flex items-center gap-3 mb-6">
              <div class="h-px w-8 bg-sky-500"></div>
              <h2 class="text-xs font-mono font-bold text-sky-500 dark:text-sky-400 tracking-widest uppercase">About</h2>
            </div>
            <div class="space-y-5 text-primary-700 dark:text-primary-300 leading-relaxed">
              <p>I approach technology with a practical mindset - systems should work reliably, securely, and transparently. Over 14 years, I've learned that the best infrastructure is the kind nobody notices because it just works.</p>
              <p>I'm currently deepening my expertise in cloud security architecture and zero-trust networking. I believe in continuous learning and sharing what I discover along the way.</p>
            </div>
          </div>

          <!-- Career Timeline -->
          <div>
            <div class="flex items-center gap-3 mb-6">
              <div class="h-px w-8 bg-sky-500"></div>
              <h2 class="text-xs font-mono font-bold text-sky-500 dark:text-sky-400 tracking-widest uppercase">Career</h2>
            </div>
            
            <div class="bg-primary-100/80 dark:bg-primary-900/60 border border-primary-200/60 dark:border-primary-800/60 backdrop-blur-md rounded-2xl p-6 shadow-sm">
              <div class="border-l-2 border-sky-500/30 ml-2 pl-6 space-y-6 relative">
                {career.map((job, idx) => (
                  <div class="relative group">
                    <!-- Node Icon -->
                    <div class:list={[
                      'absolute -left-[31px] top-1.5 h-3.5 w-3.5 rounded-full transition-transform duration-300 group-hover:scale-125',
                      idx === 0
                        ? 'bg-sky-500 ring-4 ring-sky-500/20 shadow-sm shadow-sky-500 animate-pulse'
                        : 'bg-primary-400 dark:bg-primary-700'
                    ]}></div>
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                      <span class="font-bold text-primary-900 dark:text-primary-100 text-lg group-hover:text-sky-400 transition-colors">
                        {job.company}
                      </span>
                      <span class="font-mono text-xs text-sky-600 dark:text-sky-400 bg-sky-500/10 border border-sky-500/20 px-2.5 py-0.5 rounded-full w-max">
                        {job.years}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Blog Teaser Section -->
    <section class="py-12 border-t border-primary-200/60 dark:border-primary-800/60 relative">
      <div class="max-w-6xl mx-auto px-6">
        <div class="flex items-center justify-between mb-8">
          <div class="flex items-center gap-3">
            <div class="h-px w-8 bg-sky-500"></div>
            <h2 class="text-xs font-mono font-bold text-sky-500 dark:text-sky-400 tracking-widest uppercase">From the Blog</h2>
          </div>
          <a href="/blog" class="text-sm font-semibold text-sky-500 hover:text-sky-400 transition-colors flex items-center gap-1 group">
            View all articles <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>

        {teaserArticles.length === 0 ? (
          <p class="text-primary-500 dark:text-primary-400">Articles coming soon.</p>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {featuredArticle && (
              <article class="bg-primary-100/50 dark:bg-primary-900/40 border border-primary-200/60 dark:border-primary-800/60 backdrop-blur-md rounded-2xl p-5 hover:border-sky-400/50 hover:shadow-xl transition-all duration-300 group cursor-pointer flex flex-col justify-between" onclick={`window.location.href='/blog/${featuredArticle.slug}'`}>
                <div>
                  <div class="aspect-[16/10] bg-primary-200 dark:bg-primary-800 rounded-xl mb-4 overflow-hidden relative">
                    {featuredArticle.featuredImage ? (
                      <img
                        src={featuredArticle.featuredImage}
                        alt={featuredArticle.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        loading="lazy"
                      />
                    ) : (
                      <div class="w-full h-full bg-gradient-to-br from-sky-500/20 via-primary-800 to-primary-900 group-hover:scale-105 transition-transform duration-500 flex items-center justify-center">
                        <span class="font-mono text-xs text-sky-400">Pritesh Kumar</span>
                      </div>
                    )}
                  </div>
                  <span class="font-mono text-xs font-semibold text-sky-500 dark:text-sky-400 uppercase tracking-wider bg-sky-500/10 border border-sky-500/20 px-2.5 py-0.5 rounded-md inline-block mb-2">Featured</span>
                  <h3 class="text-lg font-bold text-primary-900 dark:text-primary-100 group-hover:text-sky-400 transition-colors leading-snug">
                    {featuredArticle.title}
                  </h3>
                  <p class="text-sm text-primary-600 dark:text-primary-400 mt-2 line-clamp-2">{featuredArticle.excerpt}</p>
                </div>
              </article>
            )}
            {latestArticles.map(article => (
              <article class="bg-primary-100/50 dark:bg-primary-900/40 border border-primary-200/60 dark:border-primary-800/60 backdrop-blur-md rounded-2xl p-5 hover:border-sky-400/50 hover:shadow-xl transition-all duration-300 group cursor-pointer flex flex-col justify-between" onclick={`window.location.href='/blog/${article.slug}'`}>
                <div>
                  <div class="aspect-[16/10] bg-primary-200 dark:bg-primary-800 rounded-xl mb-4 overflow-hidden relative">
                    {article.featuredImage ? (
                      <img
                        src={article.featuredImage}
                        alt={article.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        loading="lazy"
                      />
                    ) : (
                      <div class="w-full h-full bg-gradient-to-br from-primary-800 to-primary-950 group-hover:scale-105 transition-transform duration-500 flex items-center justify-center">
                        <span class="font-mono text-xs text-primary-400">Blog Article</span>
                      </div>
                    )}
                  </div>
                  <span class="font-mono text-xs font-medium text-primary-500 dark:text-primary-400 uppercase tracking-wide inline-block mb-2">{article.category || 'Article'}</span>
                  <h3 class="text-lg font-bold text-primary-900 dark:text-primary-100 group-hover:text-sky-400 transition-colors leading-snug">
                    {article.title}
                  </h3>
                  <p class="text-sm text-primary-600 dark:text-primary-400 mt-2 line-clamp-2">{article.excerpt}</p>
                </div>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- Contact Section -->
    <section class="py-12 border-t border-primary-200/60 dark:border-primary-800/60 relative">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-8 text-primary-900 dark:text-primary-100">
          Let's Talk <span class="bg-gradient-to-r from-sky-400 via-cyan-400 to-blue-400 bg-clip-text text-transparent">Technology.</span>
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <a
            href={site.author.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="p-6 bg-primary-100/60 dark:bg-primary-900/40 border border-primary-200/60 dark:border-primary-800/60 backdrop-blur-md rounded-2xl hover:border-emerald-400/50 hover:shadow-xl transition-all group"
          >
            <div class="flex items-center gap-3 mb-3">
              <div class="p-2 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              </div>
              <span class="font-bold text-primary-900 dark:text-primary-100">WhatsApp</span>
            </div>
            <p class="text-primary-500 dark:text-primary-400 text-sm font-mono group-hover:text-emerald-400 transition-colors">{site.author.whatsappNumber}</p>
          </a>

          <a
            href={`mailto:${site.author.email}`}
            class="p-6 bg-primary-100/60 dark:bg-primary-900/40 border border-primary-200/60 dark:border-primary-800/60 backdrop-blur-md rounded-2xl hover:border-sky-400/50 hover:shadow-xl transition-all group"
          >
            <div class="flex items-center gap-3 mb-3">
              <div class="p-2 rounded-lg bg-sky-500/10 text-sky-400 border border-sky-500/20">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <span class="font-bold text-primary-900 dark:text-primary-100">Email</span>
            </div>
            <p class="text-primary-500 dark:text-primary-400 text-sm font-mono group-hover:text-sky-400 transition-colors">{site.author.email}</p>
          </a>

          <a
            href={site.author.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="p-6 bg-primary-100/60 dark:bg-primary-900/40 border border-primary-200/60 dark:border-primary-800/60 backdrop-blur-md rounded-2xl hover:border-sky-400/50 hover:shadow-xl transition-all group"
          >
            <div class="flex items-center gap-3 mb-3">
              <div class="p-2 rounded-lg bg-sky-500/10 text-sky-400 border border-sky-500/20">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </div>
              <span class="font-bold text-primary-900 dark:text-primary-100">LinkedIn</span>
            </div>
            <p class="text-primary-500 dark:text-primary-400 text-sm font-mono group-hover:text-sky-400 transition-colors">Connect on LinkedIn</p>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>