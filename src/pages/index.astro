  }
</style>

<script>
  function setupWatermarkScroll() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const watermark = document.getElementById('hero-watermark');
    if (!watermark) return;

    let ticking = false;
    const handleScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollY = window.scrollY;
          if (scrollY < 1200) {
            // Shift right to left as user scrolls down
            const moveX = scrollY * -0.35;
            watermark.style.transform = `translate3d(${moveX}px, 0, 0)`;
          }
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
  }

  setupWatermarkScroll();
  document.addEventListener('astro:page-load', setupWatermarkScroll);
</script>

<script is:inline>
  let lastActiveElement = null;

  function openSeedsModal(triggerEl) {
    lastActiveElement = triggerEl || document.activeElement;
    const modal = document.getElementById('seeds-fincap-modal');
    if (modal && typeof modal.showModal === 'function') {
      modal.showModal();
