---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found" noindex={true}>
  <div class="min-h-screen flex items-center justify-center pt-16">
    <div class="text-center px-6">
      <p class="text-8xl font-bold text-primary-200 dark:text-primary-800 mb-4">404</p>
      <h1 class="text-2xl font-bold text-primary-900 dark:text-primary-100 mb-4">Page not found</h1>
      <p class="text-primary-500 dark:text-primary-400 mb-8">The page you're looking for doesn't exist or has been moved.</p>
      <a href="/" class="px-6 py-3 bg-primary-900 dark:bg-primary-100 text-white dark:text-primary-900 text-sm font-medium rounded hover:bg-primary-800 dark:hover:bg-primary-200 transition-all">
        Back to Home
      </a>
    </div>
  </div>
</Layout>